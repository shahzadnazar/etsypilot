# EtsyPilot environment template.
#
# Every value here is a placeholder. Never commit real credentials, and never
# expose a secret to the client - only NEXT_PUBLIC_* reaches the browser bundle.
#
# The app runs COMPLETELY in demo mode with this file unchanged. Nothing below
# is required to boot, browse every screen, or run the tests.

# ---------------------------------------------------------------- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EtsyPilot

# ---------------------------------------------------------------- Mode
# "mock" serves the Willow & Fern demo shop and cannot write to Etsy.
# "live" requires the Etsy credentials below and is Phase 11.
ETSY_MODE=mock

# ------------------------------------------------- Etsy (Phase 11 - leave blank)
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_REDIRECT_URI=

# ---------------------------------------------------------------- Database
# Not needed in demo mode.
DATABASE_URL=

# ------------------------------------------------------------ Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- AI
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------- Jobs / email / monitoring / analytics
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
