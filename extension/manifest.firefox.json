{
  "manifest_version": 3,
  "name": "CobaltRank — Etsy Listing Intelligence",
  "version": "0.1.0",
  "description": "See CobaltRank listing health, keyword opportunity and your own verified figures while browsing Etsy. Read-only.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.etsy.com/*", "https://etsy.com/*"],
  "action": {
    "default_title": "CobaltRank",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/*", "https://etsy.com/*"],
      "js": ["dist/extension/src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["dist/extension/src/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@cobaltrank.app",
      "strict_min_version": "121.0"
    }
  }
}
